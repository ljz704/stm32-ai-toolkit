# hardware.yaml —— 结构化硬件信息模板
# 放在项目根目录，与 CLAUDE.md 配合使用。AI 读取本文件获取引脚/外设/约束。
# 结构参考：工具包 templates/hardware.yaml（含完整示例）。
# 用 # 注释掉的行是示例，按实际工程填写。

project:
  name: "{{PROJECT_NAME}}"
  version: "0.1.0"
  description: "{{PROJECT_NAME}} —— 项目描述（待补充）"

mcu:
  model: "{{MCU_MODEL}}"
  family: "{{MCU_FAMILY_LABEL}}"     # 如 STM32F1 / STM32F3 / STM32F4 / STM32G4（型号知识库自动填充）
  core: "{{MCU_CORE}}"               # F1: Cortex-M3；F3/F4/G4: Cortex-M4F；H7: Cortex-M7
  max_freq_mhz: {{MCU_MAX_FREQ}}     # F1/F3: 72；F4: 168；G4: 170；H7: 480
  flash_kb: {{MCU_FLASH_KB}}         # 按具体型号（C8=64KB；CBT6=128KB）
  ram_kb: {{MCU_RAM_KB}}             # F103C8=20KB；F334C8=16KB（12K 常规+4K CCM）；G431=32KB
  has_fpu: {{MCU_HAS_FPU}}           # F3/F4/G4/H7 为 true
  package: "{{MCU_PACKAGE}}"         # 封装字母：C=48 脚
  pins: {{MCU_PINS}}                 # 引脚数：C=48；R=64；Z=144
  density: "{{MCU_DENSITY}}"         # 密度字母：8=64K；B=128K
  startup_file: "{{MCU_STARTUP}}"    # SPL: f10x/f3xx/f4xx；非 SPL 家族为 N/A（走 HAL/CubeMX）
  spl_support: {{MCU_SPL}}           # true=可建 SPL 骨架；false=建议 CubeMX/HAL 生成

clock:
  hse_mhz: 8                        # 板载晶振（按实际板卡确认！默认 8MHz 只是假设）
  sysclk_mhz: {{MCU_SYSCLK}}        # 按型号主频推导（待按实际时钟树确认）
  hclk_mhz: {{MCU_HCLK}}            # 通常 = SYSCLK
  pclk1_mhz: {{MCU_PCLK1}}          # APB1 外设时钟（按家族分频）
  pclk2_mhz: {{MCU_PCLK2}}          # APB2 外设时钟（按家族分频；无 APB2 的家族填与 PCLK1 相同或 N/A）

# ==================== 外设表（留空，逐项填写） ====================
peripherals:
  # 例：SPI1 接计量芯片
  # spi1:
  #   sck: {pin: "PA5", mode: "AF_PP"}
  #   miso: {pin: "PA6", mode: "IN_FLOATING"}
  #   mosi: {pin: "PA7", mode: "AF_PP"}
  #   cs: {pin: "PA4", mode: "OUT_PP", type: "software"}
  #   device: "RN8209"
  #   mode: 0                    # CPOL=0, CPHA=0
  #   notes: "软件片选，上电延时后再初始化"

  # 例：USART1 调试串口
  # usart1:
  #   tx: {pin: "PA9", mode: "AF_PP"}
  #   rx: {pin: "PA10", mode: "IN_FLOATING"}
  #   baudrate: 115200
  #   databits: 8
  #   stopbits: 1
  #   parity: "NONE"
  #   mode: "polling"

  # 例：ADC
  # adc1:
  #   in0: {pin: "PA0", mode: "AIN", purpose: "voltage_sample"}
  #   in1: {pin: "PA1", mode: "AIN", purpose: "current_sample"}
  #   resolution: 12
  #   alignment: "RIGHT"
  #   trigger: "SOFTWARE"        # F3xx 数字电源常用 HRTIM 触发注入通道

  gpio:
    # 例：外部中断引脚
    # irq_pin:
    #   pin: "PB0"
    #   mode: "IN_FLOATING"
    #   trigger: "EXTI_Rising"
    #   purpose: "脉冲计数中断"

sensors:
  # 例：传感器 / 计量芯片
  # <sensor_name>:
  #   type: "energy_meter"
  #   interface: "SPI1"
  #   notes: ""

# ==================== 硬件约束（影响代码生成的规则） ====================
constraints:
  # 例：
  # - id: "C001"
  #   description: "外设初始化前必须延时 xxx ms"
  #   severity: "critical"

# ==================== 引脚登记表（所有已用/可用引脚都登记） ====================
pin_checklist:
  # 例：
  # - {pin: "PA0", function: "ADC1_IN0", status: "used"}
  # - {pin: "PA2", function: null, status: "available"}
